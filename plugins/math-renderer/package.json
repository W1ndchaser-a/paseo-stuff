{
  "name": "paseo-math-renderer",
  "version": "0.1.0-beta.6",
  "type": "module",
  "description": "Render block and inline LaTeX in completed Paseo replies, with source viewing, copying and native-reply mode. Experimental beta for Paseo 0.9.0-beta.1 or newer.",
  "license": "MIT",
  "author": "geoqiao",
  "repository": {
    "type": "git",
    "url": "https://github.com/geoqiao/paseo-stuff.git",
    "directory": "plugins/math-renderer"
  },
  "homepage": "https://github.com/geoqiao/paseo-stuff/tree/main/plugins/math-renderer#readme",
  "bugs": {
    "url": "https://github.com/geoqiao/paseo-stuff/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "math",
    "latex",
    "mathjax"
  ],
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/message.tsx",
    "client/transform.ts",
    "server/render.ts",
    "server/generated/wasm.ts",
    "shared/contracts.ts",
    "shared/markdown.ts",
    "shared/generated/markdown.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY.md",
    "third-party/",
    "images/",
    "package.json",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "prepare:markdown": "node server/prepare-markdown.mjs",
    "prepare:wasm": "node server/prepare-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern server/generated --ignore-pattern shared/generated --ignore-pattern tests/fixtures",
    "test": "vitest run --maxWorkers=2",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepack": "npm run prepare:markdown && npm run prepare:wasm && node scripts/pack-manifest.mjs prepare",
    "postpack": "node scripts/pack-manifest.mjs restore"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "mathjax-full": "3.2.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@getpaseo/client": "0.9.2",
    "@getpaseo/plugin": "0.9.2",
    "@getpaseo/protocol": "0.9.2",
    "@tanstack/react-query": "5.90.11",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "0.28.1",
    "markdown-it": "14.3.2",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "zod": "4.4.3"
  }
}
